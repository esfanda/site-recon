s-scoped/ava-bundle.86bdbc5edd.css\" />\n\n  <!-- Unified Floating Widget styles -->\n  <style>\n    /* Base style for the unified widget inside Hero section or floating */\n    #unified-chat-widget {\n      z-index: 999998;\n      pointer-events: auto;\n      background: transparent;\n      border: none;\n      overflow: hidden;\n      border-radius: 2.5rem;\n      box-shadow: none;\n      transform: scale(1);\n      opacity: 1;\n      transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-radius 0.4s ease !important;\n    }\n\n    /* When scrolled down, it floats smoothly to bottom-right and hides initially */\n    body.hero-gone #unified-chat-widget {\n      position: fixed !important;\n      bottom: 96px !important;\n      right: 24px !important;\n      top: auto !important;\n      left: auto !important;\n      width: 460px !important;\n      height: 480px !important;\n      z-index: 999998 !important;\n      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45) !important;\n      border-radius: 2.5rem !important;\n      pointer-events: none !important;\n      opacity: 0 !important;\n      transform: translateY(20px) scale(0.95) !important;\n    }\n\n    /* When the floating button is clicked and widget is open */\n    body.hero-gone.widget-open #unified-chat-widget {\n      pointer-events: auto !important;\n      opacity: 1 !important;\n      transform: translateY(0) scale(1) !important;\n    }\n\n    /* Mobile media query to make the unified widget fullscreen on mobile screens */\n    @media (max-width: 640px) {\n      body.hero-gone.widget-open #unified-chat-widget {\n        position: fixed !important;\n        top: 0 !important;\n        left: 0 !important;\n        bottom: 0 !important;\n        right: 0 !important;\n        width: 100vw !important;\n        height: 100vh !important;\n        border-radius: 0 !important;\n        z-index: 99999999 !important;\n        transform: none !important;\n        box-shadow: none !important;\n      }\n    }\n\n    /* Hide the floating button when at the top (Hero visible) */\n    #ava-chat-button {\n      display: none !important;\n      position: fixed !important;\n      bottom: 24px !important;\n      right: 24px !important;\n      z-index: 999999 !important;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;\n    }\n    body.hero-gone #ava-chat-button {\n      display: flex !important;\n    }\n\n    /* Custom button styling: orange rounded square with ring animation */\n    #ava-chat-button {\n      background: linear-gradient(135deg, hsl(22 100% 50%), hsl(35 100% 58%)) !important;\n      border-radius: 18px !important;\n      width: 58px !important;\n      height: 58px !important;\n      box-shadow: 0 8px 32px hsl(22 100% 50% / 0.45) !important;\n    }\n    #ava-chat-button::before {\n      content: '';\n      position: absolute;\n      inset: -4px;\n      border-radius: 22px;\n      background: linear-gradient(135deg, hsl(22 100% 50% / 0.4), hsl(35 100% 58% / 0.2));\n      animation: ava-ring 2s ease-in-out infinite;\n      z-index: -1;\n    }\n    #ava-chat-button::after {\n      content: '';\n      position: absolute;\n      inset: -8px;\n      border-radius: 26px;\n      background: linear-gradient(135deg, hsl(22 100% 50% / 0.15), transparent);\n      animation: ava-ring 2s ease-in-out infinite 0.4s;\n      z-index: -1;\n    }\n    #ava-chat-button:hover {\n      transform: scale(1.08) !important;\n      box-shadow: 0 12px 40px hsl(22 100% 50% / 0.6) !important;\n    }\n    @keyframes ava-ring {\n      0%, 100% { transform: scale(1); opacity: 0.8; }\n      50% { transform: scale(1.18); opacity: 0; }\n    }\n  </style>\n    <script type=\"module\" crossorigin src=\"/assets/index-DEdYm3vW.js\"></script>\n    <link rel=\"modulepreload\" crossorigin href=\"/assets/vendor-react-Cyeo1SpE.js\">\n    <link rel