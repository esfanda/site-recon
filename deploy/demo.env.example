# Copy to /opt/site-recon/config/demo.env and chmod 600.
SITE_RECON_DEMO_KEY=replace-me
# Recommended so the Health / PageSpeed card is not N/A for visitors:
SITE_RECON_DEMO_PAGESPEED_KEY=replace-me
# Optional: raise the daily per-IP cap for your own home IP(s) only.
# SITE_RECON_DEMO_OWNER_IPS=203.0.113.10,2001:db8::1
# SITE_RECON_DEMO_OWNER_CAP=10
